# Node & Server
NODE_ENV=development
PORT=5001
MONGODB_URI=
SESSION_SECRET=agripulse_development_secret_key_32bytes
AUTH_SESSION_SECRET=
CLIENT_ORIGIN=http://localhost:3000

# Open-Meteo Weather APIs
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_PROVIDER_TIMEOUT_MS=8000

# AI Provider Setup (Stage 11 Preparation)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
GEMINI_MIN_CONFIDENCE=0.7

# Rate Limiting & File Upload Limits
MAX_IMAGE_SIZE_BYTES=10485760
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
